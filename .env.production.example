# Domínio público servido pelo Caddy (TLS automático via Let's Encrypt)
DEVSHIP_DOMAIN=devship.example.com

# Password do utilizador devship no Postgres — gerar uma password forte, nunca reutilizar a de dev
POSTGRES_PASSWORD=change-me

# Secret usado para assinar/validar JWTs — gerar novo para produção (ex.: openssl rand -hex 32), nunca reutilizar o de dev
JWT_SECRET=change-me
# Validade do JWT em horas (opcional, default 24)
JWT_EXPIRE_HOURS=24

# ID da conta AWS usada nos fluxos de onboarding/validação de cluster
DEVSHIP_AWS_ACCOUNT_ID=306667525254

# Token do GitHub usado para leitura de repositórios / pipeline de deploy
GITHUB_TOKEN=change-me

# NÃO definir DEVSHIP_AWS_PROFILE em produção — as credenciais AWS vêm do
# instance role da EC2 via IMDS (boto3 descobre-as automaticamente)
